# Release credentials for scripts/publish.sh.
# Copy to scripts/release.env (gitignored) and fill in. Never commit the real file.

# GitHub token with Contents: read-write on the release repo (HgGamer/DDash).
GH_TOKEN=

# macOS notarization — App Store Connect API key (App Store Connect →
# Users and Access → Integrations). The .p8 is downloadable only once.
APPLE_API_KEY="$HOME/Downloads/AuthKey_XXXXXXXXXX.p8"   # path to the .p8
APPLE_API_KEY_ID=XXXXXXXXXX                              # 10-char Key ID
APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx    # Issuer UUID (one per account)
APPLE_TEAM_ID=6H26GVXHHP                                 # team that owns the Developer ID cert

# Linux (AppImage) can't be built on macOS — node-pty has no Linux prebuild.
# Build it on a Linux host, or via the electron-builder Docker image, e.g.:
#   docker run --rm -e GH_TOKEN -v "$PWD":/project -w /project \
#     electronuserland/builder:latest bash -lc "npm ci && npm run dist:publish:linux"
